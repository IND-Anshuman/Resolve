# Copy to .env.local and fill in. Never commit .env.local.

# PayPal REST app (developer.paypal.com > Apps & Credentials, Sandbox).
# Turn on Transaction Search for the app on day 1: permission changes can take hours.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# Id of the webhook you created for this app, pointing at <tunnel or Render URL>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Sandbox test card for the seed script (developer.paypal.com > Testing Tools > Card Generator)
PAYPAL_TEST_CARD_NUMBER=
# YYYY-MM
PAYPAL_TEST_CARD_EXPIRY=

# Postgres (Neon free tier works)
DATABASE_URL=

# OpenAI-compatible LLM, for the buyer chat agent
OPENAI_API_KEY=
# Optional. Point at any OpenAI-compatible server (Azure, OpenRouter, Ollama, vLLM...).
# Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional. Defaults to gpt-4o. Must support tool calling.
OPENAI_MODEL=
# Optional. Set to false if the model cannot read images; photos are then routed to the seller.
OPENAI_VISION=

# Optional: makes a "Use the demo order" button appear in the help chat. `npm run seed:scenarios`
# prints values to use here. Sandbox orders only.
DEMO_ORDER_ID=
DEMO_ORDER_EMAIL=

# Optional sponsor integrations. Missing values disable the adapter without affecting refunds.
APP_URL=http://localhost:3000
CRON_SECRET=
CONSOLE_ACCESS_TOKEN=
APPROVAL_EXPIRY_HOURS=48
ZAPIER_WEBHOOK_URL=
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=resolve
